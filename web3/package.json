{
  "name": "hardhat-javascript-starter",
  "scripts": {
    "compile": "node scripts/hardhat-cli.js compile",
    "test": "node scripts/hardhat-cli.js test",
    "check:amoy": "node scripts/check-amoy-readiness.js",
    "deploy:hardhat": "node scripts/hardhat-cli.js run scripts/deploy.js --network hardhat",
    "deploy:local": "node scripts/hardhat-cli.js run scripts/deploy.js --network localhost",
    "deploy:amoy": "node scripts/hardhat-cli.js run scripts/deploy.js --network polygon_amoy",
    "verify:amoy": "node scripts/verify-amoy-deployment.js",
    "build": "npx thirdweb@latest detect",
    "deploy": "npx thirdweb@latest deploy",
    "release": "npx thirdweb@latest release"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@thirdweb-dev/contracts": "^3",
    "ethers": "^5.7.2"
  }
}
